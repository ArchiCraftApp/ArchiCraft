{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime --hook-json"
          },
          {
            "type": "command",
            "timeout": 30,
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$d/scripts/loop/hooks/session-context.sh\" ] && exec bash \"$d/scripts/loop/hooks/session-context.sh\"; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$d/scripts/loop/hooks/guard-edit.sh\" ] && exec bash \"$d/scripts/loop/hooks/guard-edit.sh\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$d/scripts/loop/hooks/guard-bash.sh\" ] && exec bash \"$d/scripts/loop/hooks/guard-bash.sh\"; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$d/scripts/loop/hooks/format-rust.sh\" ] && exec bash \"$d/scripts/loop/hooks/format-rust.sh\"; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "bead-reviewer",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$d/scripts/loop/hooks/review-verdict.sh\" ] && exec bash \"$d/scripts/loop/hooks/review-verdict.sh\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 1800,
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$d/scripts/loop/hooks/stop-gate.sh\" ] && exec bash \"$d/scripts/loop/hooks/stop-gate.sh\"; exit 0"
          }
        ]
      }
    ]
  }
}
